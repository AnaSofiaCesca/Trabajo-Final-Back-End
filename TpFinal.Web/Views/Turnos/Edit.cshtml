@model TurnoDTO

@{
    ViewData["Title"] = "Editar Turno";
}

<h2>Editar Turno</h2>
<p class="text-muted">Modificar día, horario, profesional o motivo del turno</p>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="PacienteId" />

            <div class="mb-3">
                <label class="form-label">Paciente</label>
                <p class="form-control-plaintext fw-semibold mb-1">
                    @Model.PacienteNombreCompleto - DNI @Model.PacienteDni
                </p>
                <a asp-controller="Pacientes" asp-action="Edit" asp-route-id="@Model.PacienteId" class="btn btn-sm btn-outline-secondary">
                    Editar datos del paciente
                </a>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Fecha" class="form-label">Día (lunes a viernes)</label>
                    <select asp-for="Fecha" asp-items="ViewBag.Dias" class="form-select">
                        <option value="">-- Día --</option>
                    </select>
                    <span asp-validation-for="Fecha" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Hora" class="form-label">Horario</label>
                    <select asp-for="Hora" asp-items="ViewBag.Horarios" class="form-select">
                        <option value="">-- Horario --</option>
                    </select>
                    <span asp-validation-for="Hora" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="DoctorId" class="form-label">Profesional</label>
                <select asp-for="DoctorId" asp-items="ViewBag.Doctores" class="form-select">
                    <option value="0">-- Seleccione un doctor --</option>
                </select>
                <span asp-validation-for="DoctorId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Motivo" class="form-label">Motivo</label>
                <input asp-for="Motivo" class="form-control" />
                <span asp-validation-for="Motivo" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Observaciones" class="form-label">Observaciones</label>
                <textarea asp-for="Observaciones" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Observaciones" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Guardar cambios</button>
            <a asp-action="Index" class="btn btn-secondary">Volver</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
