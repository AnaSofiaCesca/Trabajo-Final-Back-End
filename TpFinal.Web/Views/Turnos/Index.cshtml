@model IEnumerable<TurnoDTO>
@using TpFinal.Core.Enums

@{
    ViewData["Title"] = "Turnos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Gestión de Turnos</h2>
        <p class="text-muted">Asignación de turnos entre doctores y pacientes</p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        Solicitar turno
    </a>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Fecha y hora</th>
                        <th>Doctor</th>
                        <th>Paciente</th>
                        <th>Estado</th>
                        <th>Motivo</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var turno in Model)
                        {
                            var claseEstado = turno.Estado switch
                            {
                                EstadoTurno.Pendiente => "bg-warning text-dark",
                                EstadoTurno.Confirmado => "bg-primary",
                                EstadoTurno.Atendido => "bg-success",
                                EstadoTurno.Cancelado => "bg-secondary",
                                _ => "bg-light text-dark"
                            };

                            <tr>
                                <td>@turno.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @turno.DoctorNombreCompleto
                                    <br />
                                    <small class="text-muted">@turno.DoctorEspecialidad</small>
                                </td>
                                <td>
                                    @turno.PacienteNombreCompleto
                                    <br />
                                    <small class="text-muted">DNI @turno.PacienteDni</small>
                                </td>
                                <td><span class="badge @claseEstado">@turno.Estado</span></td>
                                <td>@turno.Motivo</td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1">
                                        <a asp-action="Details" asp-route-id="@turno.Id" class="btn btn-sm btn-outline-info">Ver</a>
                                        <a asp-action="Edit" asp-route-id="@turno.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                        <a asp-action="Delete" asp-route-id="@turno.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted">
                                No hay turnos registrados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
