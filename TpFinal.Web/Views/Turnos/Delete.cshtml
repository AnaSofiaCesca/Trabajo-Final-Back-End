@model TurnoDTO

@{
    ViewData["Title"] = "Eliminar Turno";
}

<h2>Eliminar Turno</h2>

<div class="alert alert-warning">
    ¿Está seguro de que desea eliminar este turno? Esta acción no se puede deshacer.
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Fecha y hora</dt>
            <dd class="col-sm-9">@Model.FechaHora.ToString("dd/MM/yyyy HH:mm")</dd>

            <dt class="col-sm-3">Doctor</dt>
            <dd class="col-sm-9">@Model.DoctorNombreCompleto</dd>

            <dt class="col-sm-3">Paciente</dt>
            <dd class="col-sm-9">@Model.PacienteNombreCompleto - DNI @Model.PacienteDni</dd>

            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9">@Model.Estado</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="mt-3">
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
