@model TurnoDTO

@{
    ViewData["Title"] = "Detalle del Turno";
}

<h2>Detalle del Turno</h2>

<div class="card shadow-sm">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Fecha y hora</dt>
            <dd class="col-sm-9">@Model.FechaHora.ToString("dd/MM/yyyy HH:mm")</dd>

            <dt class="col-sm-3">Doctor</dt>
            <dd class="col-sm-9">@Model.DoctorNombreCompleto (@Model.DoctorEspecialidad)</dd>

            <dt class="col-sm-3">Paciente</dt>
            <dd class="col-sm-9">@Model.PacienteNombreCompleto - DNI @Model.PacienteDni</dd>

            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9">@Model.Estado</dd>

            <dt class="col-sm-3">Motivo</dt>
            <dd class="col-sm-9">@Model.Motivo</dd>

            <dt class="col-sm-3">Observaciones</dt>
            <dd class="col-sm-9">@Model.Observaciones</dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</div>
