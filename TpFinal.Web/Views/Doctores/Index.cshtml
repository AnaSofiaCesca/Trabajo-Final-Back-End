@model IEnumerable<DoctorDTO>

@{
    ViewData["Title"] = "Doctores";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Gestión de Doctores</h2>
        <p class="text-muted">Administración del personal médico</p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Nuevo Doctor
    </a>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Nombre</th>
                        <th>Apellido</th>
                        <th>Matrícula</th>
                        <th>Especialidad</th>
                        <th>Teléfono</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var doctor in Model)
                        {
                            <tr>
                                <td>@doctor.Nombre</td>
                                <td>@doctor.Apellido</td>
                                <td>@doctor.Matricula</td>
                                <td>@doctor.Especialidad</td>
                                <td>@doctor.Telefono</td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details"
                                           asp-route-id="@doctor.Id"
                                           class="btn btn-info">
                                            Ver
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@doctor.Id"
                                           class="btn btn-warning">
                                            Editar
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@doctor.Id"
                                           class="btn btn-danger">
                                            Eliminar
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted">
                                No hay doctores registrados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>